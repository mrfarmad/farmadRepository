# System Configuration
NODE_ENV=development
LOG_LEVEL=info
OFFLINE_MODE=false

# RS-485 Serial Port
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=9600
SERIAL_TIMEOUT=5000

# Modbus TCP Gateway
MODBUS_TCP_PORT=5023
MODBUS_TCP_TIMEOUT=3000
MODBUS_MAX_CONNECTIONS=10

# Database
DB_PATH=storage/edge_data.db
DB_COMMANDS_PATH=data/edge_commands.db
DB_JOURNAL_MODE=WAL
DB_TIMEOUT=5000

# Services
TELEGRAM_ENABLED=true
WEBSOCKET_ENABLED=true
MQTT_ENABLED=false
GATEWAY_ENABLED=true
HEALTH_API_PORT=8090

# WebSocket
WEBSOCKET_PORT=8000

# MQTT (Optional)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=cube_rs
MQTT_PUBLISH_INTERVAL=10000

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Edge Server Authentication
EDGE_SERVER_URL=
EDGE_PING_INTERVAL=60000
EDGE_USE_MTLS=true

# Security
MASTER_PASSWORD=
ENCRYPTION_ALGORITHM=aes-256-gcm

# Monitoring
PROMETHEUS_PORT=9090
