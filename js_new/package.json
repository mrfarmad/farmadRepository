{
  "name": "edge-gateway-nodejs",
  "version": "1.0.0",
  "description": "Industrial IoT Gateway for farm equipment monitoring via Modbus RTU/TCP - Node.js implementation",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "modbus",
    "industrial-iot",
    "gateway",
    "rs485",
    "farm-automation",
    "telegram-bot",
    "edge-computing"
  ],
  "author": "",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "async-mqtt": "^2.6.3",
    "better-sqlite3": "^9.3.0",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "js-yaml": "^4.1.0",
    "jsmodbus": "^4.0.6",
    "node-telegram-bot-api": "^0.63.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "serialport": "^12.0.0",
    "systeminformation": "^5.21.23",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.16",
    "@types/node-telegram-bot-api": "^0.64.2",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
